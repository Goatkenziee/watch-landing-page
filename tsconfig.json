{  
  "compilerOptions": {  
    "target": "es6",  
    "module": "commonjs",  
    "jsx": "preserve",  
    "strict": true,  
    "esModuleInterop": true,  
    "skipLibCheck": true,  
    "forceConsistentCasingInFileNames": true  
  },  
  "include": ["app/**/*"],  
  "exclude": ["node_modules"]  
}